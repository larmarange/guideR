# a binomial example

m <- MAIHDA::maihda(
  Survived ~ Age + Sex + Class + (1 | Age:Sex:Class),
  data = titanic,
  family = binomial
)

m |> tbl_strata_info()
m |> tbl_maihda(exponentiate = TRUE)
m |> tbl_strata_predictions(n_strata = NULL)
m |> tbl_strata_predictions(which = "adjusted", n_strata = 3)

